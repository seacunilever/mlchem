# GitHub Linguist overrides
# https://github.com/github-linguist/linguist/blob/main/docs/overrides.md
# Note: .gitattributes does NOT support inline comments — keep comments on
# their own lines, otherwise the trailing text breaks the rule.

# Built Sphinx site — generated documentation, not part of the codebase.
docs/**                  linguist-generated=true

# Test artefacts (HTML plots, fixtures, etc.) — keep .py test code counted.
tests/**                 linguist-generated=true
tests/**/*.py            linguist-generated=false

# Plotly demo bundled with the chemical-space example.
examples/**/*.html       linguist-generated=true
